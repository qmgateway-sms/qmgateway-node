{
  "name": "@qmgateway/sdk",
  "version": "0.1.0",
  "description": "Send SMS and one-time passwords with QMGateway. No runtime dependencies.",
  "license": "MIT",
  "homepage": "https://github.com/qmgateway-sms/qmgateway-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmgateway-sms/qmgateway-node.git"
  },
  "bugs": {
    "url": "https://github.com/qmgateway-sms/qmgateway-node/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    }
  },
  "bin": {
    "qmgateway": "./bin/qmgateway.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "npm run build && node --test",
    "test:live": "node tests/live.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
